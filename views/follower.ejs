<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GC |Followers</title>
   <link rel="icon" href="/images/title2.png" type="image/png" />
  <link rel="stylesheet" href="/follower.css">
</head>
<body>
<% for(let m of memberpic){ %>
  <div class="member">
    <img src="<%= m.image %>" alt="Profile Picture" class="profile-pic">
    <p class="name"><%= m.name %></p>

    <a href="/message/<%= m.name %>" class="message">Message</a>
    <a href="/delete-follower/<%= m.name %>" class="delete">Remove</a>
  </div>
  <% } %>





<%- include('includes/footer.ejs'); %>
<script>
  // Select all delete links
  const deleteLinks = document.querySelectorAll('.delete');

  deleteLinks.forEach(link => {
    link.addEventListener('click', function (event) {
      event.preventDefault(); // stop default navigation

      const name = this.getAttribute('href').split('/').pop(); // get name from URL
      const confirmDelete = confirm(`Are you sure you want to remove ${name}?`);

      if (confirmDelete) {
        window.location.href = this.href; // go to /delete-follower/<name>
      }
    });
  });
</script>


  
</body>

</html>
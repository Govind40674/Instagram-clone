<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>chat-member</title>
  <link rel="stylesheet" href="/index.css">
</head>
<body>

<%- include('includes/header.ejs'); %>

<div class="feed-container">
  <% for(let normal of posts){ %>
    <div class="post">
      <img src="<%= normal.image %>" alt="Post Image" class="post-image">
      <p><%= normal.caption %></p>
      <span class="post-date"><%= normal.createdAt.toLocaleString() %></span>
    </div>
  <% } %>

  <% for(let admin of posts_admin) { %>
    <div class="post-admin">
      <img src="<%= admin.image %>" alt="Post Image" class="post-image">
      <p><%= admin.caption %></p>
      <span class="post-date"><%= admin.createdAt.toLocaleString() %></span>
    </div>
  <% } %>
</div>

<%- include('includes/footer.ejs'); %>

</body>
</html>
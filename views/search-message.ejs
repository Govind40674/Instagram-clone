<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GC |<%=member.name%>'s Messages"</title>
   <link rel="icon" href="/images/title2.png" type="image/png" />
  <link rel="stylesheet" href="/search-message.css">
</head>
<body>
  
  <h2><%=member.name%>"s Messages</h2>
  <div id="message-list">
    <img src="<%=member.image%>" alt="<%=member.name%>'s profile picture" class="image">
     <span class="follower-name"><%= member.name %></span>
          <a href="/message/<%= member.name %>">
            <button class="msg-btn">Message</button>
          </a>
  </div>

  <%- include('includes/footer.ejs'); %>
  
</body>
</html>